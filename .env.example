# Copy to `.env.local` for local runs. Provider onboarding welcome + verification emails use SMTP via `src/lib/email.ts`:

EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
# Optional: EMAIL_SERVER_SECURE=true|false (defaults to secure for port 465)
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
# Public Meta Pixel identifier used for website visit and provider lead measurement.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only CAPI settings. Keep disabled until Test Events + privacy review.
META_CAPI_ENABLED=false
META_CONVERSIONS_API_ACCESS_TOKEN=
# Set a supported Meta Graph API version, e.g. v23.0; verify before activation.
META_GRAPH_API_VERSION=
# Required for preview/local testing. Remove for live production measurement.
META_CAPI_TEST_EVENT_CODE=
# Optional timeouts (milliseconds):
# EMAIL_CONNECTION_TIMEOUT_MS=
# EMAIL_GREETING_TIMEOUT_MS=
# EMAIL_SOCKET_TIMEOUT_MS=
