rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function participant(data) {
      return request.auth != null && (data.userId == request.auth.uid || data.providerId == request.auth.uid);
    }
    // Financial state is server-owned, including legacy bookings. Admin SDK bypasses rules.
    match /bookings/{id} {
      allow read: if participant(resource.data);
      allow write: if false;
      match /offerHistory/{version} {
        allow read: if participant(get(/databases/$(database)/documents/bookings/$(id)).data);
        allow write: if false;
      }
    }
    match /payments/{id} {
      allow read: if participant(resource.data);
      allow write: if false;
    }
    match /admini/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if false;
    }
    match /admin_settings/{id} {
      allow read: if id == 'mobile_app_update';
      allow write: if false;
    }
    // Preserve the existing development policy outside this financial boundary.
    // This fallback is not a complete production security policy.
    match /{collection}/{document=**} {
      allow read, write: if !(collection in ['bookings', 'payments', 'admin_settings',
        'providerBookingLocks', 'stripeWebhookEvents', 'idempotencyKeys', 'counters', 'admini']);
    }
  }
}
